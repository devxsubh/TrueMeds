# Gemini (required for analyze)
GEMINI_API_KEY=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — omit for local SQLite (api/data/truemeds.db)
# Render: set to the Postgres DATABASE_URL from the dashboard / Blueprint
DATABASE_URL=

# CORS — comma-separated origins (Vercel URL + local)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional
PORT=8000
