				{
					"name": "Sign Up",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.tokens) {",
									"        pm.environment.set(\"access_token\", jsonData.data.tokens.access.token);",
									"        pm.environment.set(\"refresh_token\", jsonData.data.tokens.refresh.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"userName\": \"johndoe123\",\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/signup",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "signup"]
						},
						"description": "Register a new user. Requires firstName, lastName, userName (alphanumeric, 6-66 chars), email, and password (min 6 chars)."
					},
					"response": []
				},
